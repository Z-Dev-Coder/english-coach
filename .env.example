# --- Core ---
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Dev default is SQLite, stored at the project root. Relative sqlite paths are
# anchored to the project root by settings.py, so the same database is used no
# matter which directory you launch from.
# To use PostgreSQL, install it and switch to:
# DATABASE_URL=postgres://user:password@localhost:5432/english_coach
DATABASE_URL=sqlite:///db.sqlite3

# --- Frontend / CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI provider abstraction ---
# Supported: ollama  (openai / anthropic are future providers, not required)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# Model tiers (see docs/ARCHITECTURE.md section "AI model strategy").
# SMALL  -> classification, vocabulary extraction, structured transforms
# MEDIUM -> lesson generation, explanations, conversation, feedback
# LARGE  -> only when available; falls back to MEDIUM if unset
AI_MODEL_SMALL=qwen2.5:3b-instruct-q4_K_M
AI_MODEL_MEDIUM=qwen2.5:7b-instruct-q4_K_M
AI_MODEL_LARGE=

# --- Optional hosted providers ------------------------------------------
# Everything works on local Ollama. A hosted model is worth considering for one
# thing specifically: feedback quality. Small local models reliably notice that
# something is wrong but are vague about which exact words, and tend to label
# every error "grammar" — which matters because the mistake bank keys on the
# corrected pair.
#
# For a single learner the volume is a few thousand tokens a day, so the cost is
# small. Check current pricing before committing.
#
# To use DeepSeek: add the key below and set AI_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
# Optional per-tier overrides. Defaults (verified September 2026):
#   small/medium = deepseek-v4-flash   (cheap; fine for lessons and chat)
#   large        = deepseek-v4-pro     (used for writing and conversation review)
# Note: deepseek-chat and deepseek-reasoner were retired on 2026-07-24.
DEEPSEEK_MODEL_SMALL=
DEEPSEEK_MODEL_MEDIUM=
DEEPSEEK_MODEL_LARGE=

OPENAI_API_KEY=
OPENAI_MODEL_SMALL=
OPENAI_MODEL_MEDIUM=
OPENAI_MODEL_LARGE=

AI_REMOTE_TIMEOUT=90
